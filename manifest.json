{
  "manifest_version": 3,
  "name": "Vimlite",
  "version": "0.2.0",
  "description": "Minimal Vim-style keys for scrolling pages and following links.",
  "permissions": ["storage"],
  "action": {
    "default_title": "Vimlite",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
